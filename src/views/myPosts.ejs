<%- include("partials/head", {title: "My Posts" , css: "/css/post-list.css" }) %>

  <%- include("partials/navbar") %>

    <main class="posts-page">
      <div class="post-header">
        <div>
          <h1>My Posts</h1>
          <p>Manage all your posts.</p>
        </div>

        <a href="/posts/create" class="create-post-btn">+ Create Post</a>
      </div>
      <nav class="post-tabs">
        <a href="/my-posts" class="active">All Posts</a>
        <a href="/my-posts/published">Published</a>
        <a href="/my-posts/drafts">Drafts</a>
      </nav>

      <% if (!posts || posts.length===0) {%>
        <div class="empty-state">
          <h2>No posts yet</h2>
          <p>You haven't created any posts yet.</p>
          <a href="/posts/create" class="create-post-btn">Create your first post</a>
        </div>
        <%} else {%>
          <div class="posts-grid">
            <% posts.forEach((post)=>{%>
              <article class="post-card">

                <div class="post-card-header">
                  <span class="status-badge <%= post.status.toLowerCase() %>">
                    <%= post.status %>
                  </span>
                  <span class="post-date">
                    <%= post.createdAt.toLocaleDateString() %>
                  </span>
                </div>
                <h2>
                  <%= post.title %>
                </h2>
                <p class="post-preview">
                  <%= post.content.length>180? post.content.slice(0,180)+".....": post.content %>
                </p>
                <% if (post.tags && post.tags.length> 0) { %>
                  <div class="post-tags">
                    <% post.tags.forEach(tag=> { %>
                      <span>#<%= tag %></span>
                      <% }) %>
                  </div>
                  <% } %>
                    <div class="post-card-actions">
                      <a href="/posts/<%=post._id%>/edit" class="edit-post-btn">Edit</a>
                    </div>
                    <form action="/posts/<%= post._id%>/delete" class="delete-post-form" method="POST">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="delete-post-btn">
                        Delete
                      </button>
                    </form>

                    <div class="post-card-footer">
                      <span>
                        Updated <%= post.updatedAt.toLocaleDateString() %>
                      </span>
                    </div>
              </article>
              <%})%>
          </div>

          <%} %>

    </main>
    <!-- <%- include("partials/footer") %> -->
